<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="MSc Geography WebGIS project presenting the geographical and administrative features of Melila Grama Panchayat, Kollam district, Kerala.">

    <meta name="theme-color" content="#14532d">

    <title>Melila Grama Panchayat | WebGIS Project</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet">

    <!-- Leaflet CSS -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <style>
        /* =================================
           GENERAL STYLES
        ================================= */

        :root {
            --primary: #14532d;
            --primary-light: #2d6a4f;
            --secondary: #dcfce7;
            --accent: #b9e4c9;
            --background: #f5f8f5;
            --white: #ffffff;
            --text: #24352a;
            --muted: #647469;
            --border: #dce8df;
            --shadow: 0 8px 28px rgba(20, 83, 45, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
            background: var(--background);
            color: var(--text);
            line-height: 1.7;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
        }

        .container {
            width: min(1120px, 92%);
            margin: auto;
        }

        section {
            padding: 65px 0;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 35px;
        }

        .section-heading h2 {
            font-size: clamp(25px, 4vw, 34px);
            color: var(--primary);
            margin-bottom: 10px;
        }

        .section-heading p {
            max-width: 720px;
            margin: auto;
            color: var(--muted);
        }

        .eyebrow {
            display: inline-block;
            color: var(--primary-light);
            background: var(--secondary);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        /* =================================
           NAVIGATION
        ================================= */

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.97);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }

        .nav-content {
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--primary);
            font-weight: 800;
        }

        .brand-symbol {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            background: var(--primary);
            color: white;
            border-radius: 12px;
            font-size: 21px;
        }

        .brand small {
            display: block;
            font-size: 10px;
            letter-spacing: 1px;
            color: var(--muted);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 22px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--primary-light);
        }

        .nav-toggle {
            display: none;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: white;
            color: var(--primary);
            font-size: 23px;
            padding: 4px 12px;
            cursor: pointer;
        }

        /* =================================
           GOVERNMENT INTRODUCTION
        ================================= */

        .government-section {
            padding: 55px 0;
            background: linear-gradient(135deg, #edf7ef, #ffffff);
            border-bottom: 1px solid var(--border);
        }

        .government-card {
            background: var(--white);
            padding: 38px;
            border: 1px solid var(--border);
            border-radius: 22px;
            box-shadow: var(--shadow);
            text-align: center;
        }

        .government-card h1 {
            font-family: 'Playfair Display', Georgia, serif;
            color: var(--primary);
            font-size: clamp(25px, 4vw, 38px);
            letter-spacing: 1px;
            margin-bottom: 20px;
        }

        .government-logo {
            width: 135px;
            height: 135px;
            object-fit: contain;
            margin: 0 auto 24px;
        }

        .government-card p {
            max-width: 850px;
            margin: auto;
            text-align: justify;
            color: #46554a;
            font-size: 14px;
        }

        .green-divider {
            width: 100px;
            height: 4px;
            background: var(--primary-light);
            border: none;
            margin: 25px auto 0;
            border-radius: 10px;
        }

        /* =================================
           HERO SECTION
        ================================= */

        .hero {
            padding: 65px 0 55px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 45px;
            align-items: center;
        }

        .hero h1 {
            font-family: 'Playfair Display', Georgia, serif;
            color: var(--primary);
            font-size: clamp(35px, 5vw, 56px);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #3c8057;
        }

        .hero-description {
            color: var(--muted);
            margin-bottom: 26px;
            font-size: 15px;
        }

        .hero-image-wrapper {
            position: relative;
        }

        .hero-image {
            width: 100%;
            height: 360px;
            object-fit: cover;
            border-radius: 22px;
            box-shadow: var(--shadow);
            border: 5px solid white;
        }

        .image-caption {
            position: absolute;
            bottom: 18px;
            left: 18px;
            right: 18px;
            background: rgba(20, 83, 45, 0.92);
            color: white;
            padding: 13px 17px;
            border-radius: 12px;
            font-size: 13px;
        }

        .hero-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }

        .hero-tag {
            background: var(--secondary);
            color: var(--primary);
            padding: 7px 12px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            padding: 13px 21px;
            background: var(--primary);
            color: white;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            border: 2px solid var(--primary);
            transition: 0.2s ease;
        }

        .button:hover {
            background: #20683d;
            border-color: #20683d;
            transform: translateY(-2px);
        }

        .button-outline {
            background: white;
            color: var(--primary);
        }

        .button-outline:hover {
            color: white;
        }

        /* =================================
           PROJECT INFORMATION STRIP
        ================================= */

        .project-strip {
            background: var(--primary);
            color: white;
            padding: 25px 0;
        }

        .strip-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            text-align: center;
        }

        .strip-item strong {
            display: block;
            font-size: 17px;
            margin-bottom: 4px;
        }

        .strip-item span {
            color: #d5eadb;
            font-size: 12px;
        }

        /* =================================
           GEOGRAPHICAL INFORMATION
        ================================= */

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .info-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 26px;
            box-shadow: var(--shadow);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(20, 83, 45, 0.12);
        }

        .card-icon {
            width: 45px;
            height: 45px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: var(--secondary);
            font-size: 22px;
            margin-bottom: 15px;
        }

        .info-card h3 {
            color: var(--primary);
            font-size: 18px;
            margin-bottom: 16px;
        }

        .info-card ul {
            list-style: none;
        }

        .info-card li {
            padding: 10px 0;
            border-bottom: 1px solid #edf2ee;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .info-card li:last-child {
            border-bottom: none;
        }

        .info-card strong {
            color: #344d3b;
        }

        /* =================================
           LOCATION MAP
        ================================= */

        .map-section {
            background: #edf5ee;
        }

        .map-card {
            background: white;
            padding: 15px;
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        #map {
            height: 430px;
            width: 100%;
            border-radius: 13px;
            background: #e7eee8;
            z-index: 1;
        }

        .map-note {
            padding: 14px 8px 3px;
            color: var(--muted);
            font-size: 12px;
        }

        .static-map {
            width: 100%;
            max-height: 500px;
            object-fit: contain;
            background: #f8faf8;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 8px;
        }

        .static-map-wrapper {
            margin-top: 30px;
        }

        /* =================================
           RESOURCE MAP
        ================================= */

        .resource-card {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 25px;
            align-items: center;
            background: linear-gradient(135deg, #14532d, #287448);
            color: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: var(--shadow);
        }

        .resource-card h3 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .resource-card p {
            color: #e1f0e5;
            font-size: 14px;
            max-width: 650px;
        }

        .resource-card .button {
            background: white;
            border-color: white;
            color: var(--primary);
            white-space: nowrap;
        }

        .resource-card .button:hover {
            background: var(--secondary);
            border-color: var(--secondary);
        }

        /* =================================
           CONTACT
        ================================= */

        .contact-section {
            padding: 55px 0;
        }

        .contact-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 30px;
            text-align: center;
            box-shadow: var(--shadow);
        }

        .contact-card h2 {
            color: var(--primary);
            font-size: 25px;
            margin-bottom: 18px;
        }

        .contact-name {
            font-weight: 800;
            font-size: 16px;
        }

        .contact-card a {
            color: var(--primary-light);
            text-decoration: none;
            overflow-wrap: anywhere;
        }

        .contact-card a:hover {
            text-decoration: underline;
        }

        .contact-role {
            color: var(--muted);
            font-size: 12px;
            margin-top: 5px;
        }

        /* =================================
           FOOTER
        ================================= */

        footer {
            background: #0c3520;
            color: white;
            padding: 28px 0;
            text-align: center;
        }

        footer p {
            font-size: 12px;
            color: #d3e5d8;
        }

        .footer-links {
            margin-top: 12px;
        }

        .footer-links a {
            display: inline-block;
            margin: 5px 10px;
            color: white;
            font-size: 12px;
            text-decoration: none;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        .project-date {
            margin-top: 12px;
            font-size: 11px;
            color: #b7d3bf;
        }

        /* =================================
           RESPONSIVE DESIGN
        ================================= */

        @media (max-width: 850px) {

            .hero-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .hero-image {
                height: 320px;
            }

            .nav-toggle {
                display: block;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 72px;
                left: 0;
                right: 0;
                background: white;
                padding: 18px 5%;
                border-bottom: 1px solid var(--border);
                flex-direction: column;
                align-items: flex-start;
                gap: 18px;
            }

            .nav-links.active {
                display: flex;
            }

            .resource-card {
                grid-template-columns: 1fr;
            }

            .resource-card .button {
                justify-self: start;
            }
        }

        @media (max-width: 600px) {

            section {
                padding: 45px 0;
            }

            .government-section {
                padding: 30px 0;
            }

            .government-card {
                padding: 24px 20px;
            }

            .government-logo {
                width: 110px;
                height: 110px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .strip-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .hero {
                padding-top: 42px;
            }

            .hero-image {
                height: 250px;
            }

            .resource-card {
                padding: 25px;
            }

            #map {
                height: 320px;
            }

            .brand {
                font-size: 13px;
            }

            .brand small {
                font-size: 9px;
            }
        }

        /* Accessibility: respect reduced-motion preferences */

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

